{{>header}}
<main class="container">
    <h2 class="form-title">Preguntas Reportadas</h2>
    <p class="form-help">Revisá reportes enviados por jugadores y aprobá o rechazá el reporte.</p>

    <div class="proposal-filters editor-tabs-inline">
        <a href="/editor/preguntas" class="btn-secondary">Preguntas del juego</a>
        <a href="/preguntaCreada/propuestas" class="btn-secondary">Preguntas sugeridas</a>
        <a href="/editor/reportes" class="btn-secondary filter-active">Preguntas reportadas</a>
    </div>

    <table>
        <thead>
        <tr>
            <th>Pregunta</th>
            <th>Usuario</th>
            <th>Motivo</th>
            <th>Fecha</th>
            <th>Acciones</th>
        </tr>
        </thead>
        <tbody>
        {{#reportes}}
            <tr>
                <td>{{pregunta}}</td>
                <td>{{usuario}}</td>
                <td>{{motivo}}</td>
                <td>{{fecha}}</td>
                <td>
                    <div class="proposal-actions">
                        <a href="/editor/verReporte?id={{id}}" class="btn-secondary proposal-view-button">Ver pregunta</a>
                        <form action="/editor/resolverReporte" method="POST">
                            <input type="hidden" name="id" value="{{id}}">
                            <input type="hidden" name="estado" value="rechazada">
                            <button type="submit" class="btn-secondary btn-aprobar">Mantener pregunta</button>
                        </form>
                        <form action="/editor/resolverReporte" method="POST">
                            <input type="hidden" name="id" value="{{id}}">
                            <input type="hidden" name="estado" value="aprobada">
                            <button type="submit" class="btn-secondary btn-rechazar">Dar de baja</button>
                        </form>
                    </div>
                </td>
            </tr>
        {{/reportes}}

        {{^reportes}}
            <tr>
                <td colspan="5">No hay reportes pendientes.</td>
            </tr>
        {{/reportes}}
        </tbody>
    </table>

    <a href="/editor/preguntas" class="back-link">Volver al panel editor</a>
</main>

<style>
    .proposal-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .editor-tabs-inline {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-bottom: 20px;
    }

    .editor-tabs-inline .filter-active {
        background: linear-gradient(135deg, var(--primary), var(--secondary));
        border-color: transparent;
        color: #ffffff;
    }

    .proposal-actions form {
        margin: 0;
    }

    .proposal-actions button {
        cursor: pointer;
        font-size: 0.85rem;
        padding: 8px 14px;
    }

    .proposal-view-button {
        display: inline-flex;
        font-size: 0.85rem;
        padding: 8px 14px;
        white-space: nowrap;
    }

    .btn-aprobar {
        background: #ecfdf5;
        border: 1px solid #a7f3d0;
        color: var(--success);
    }

    .btn-rechazar {
        background: #fef2f2;
        border: 1px solid #fecaca;
        color: var(--danger);
    }
</style>
{{>footer}}
