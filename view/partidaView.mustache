{{>header}}
{{>partidaCss}}
<main class="container game-shell">
    <section class="question-stage">
        <div class="game-topbar">
            <span class="question-pill">Pregunta numero {{numeroPregunta}}</span>
            <span class="category-pill">{{categoria}}</span>
            <span class="difficulty-pill difficulty-{{dificultadClase}}">{{dificultad}}</span>
        </div>

        <article class="question-card">
            <h2>{{pregunta}}</h2>
            <p class="question-helper">Eleg&iacute; una respuesta para avanzar a la siguiente pregunta.</p>

            <div class="time-box">
                Tiempo restante: 
                <span id="time">15</span>
            </div>

            <form class="answer-grid" action="/partida/responder" method="post">
                {{#respuestas}}
                <button class="answer-option" type="submit" name="respuesta_id" value="{{id}}">
                    <span>{{texto}}</span>
                </button>
                {{/respuestas}}
            </form>

            <form class="report-question-form" action="/partida/prepararReporte" method="post">
                <button type="submit" class="report-link-button">Reportar</button>
            </form>


            <div class="game-footer">
                <span class="score-preview">Puntaje: {{usuarioPuntaje}}</span>

            </div>
        </article>
    </section>
</main>

<script>
    let tiempo = 15;
    const time = document.getElementById("time");

    const intervalo = setInterval(() => {
        tiempo--;
        time.innerText = tiempo;

        if (tiempo <= 0) {
            clearInterval(intervalo);
            window.location.href = "/partida/timeout";
        }
    }, 1000);

</script>

{{>footer}}
