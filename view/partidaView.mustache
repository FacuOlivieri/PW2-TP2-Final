{{>header}}

<style>
    .game-shell {
        overflow: hidden;
        padding: 0;
        border-color: rgba(212, 175, 55, 0.35);
    }

    .question-stage {
        position: relative;
        padding: 34px;
        background:
                radial-gradient(circle at 16% 18%, rgba(212, 175, 55, 0.22), transparent 28%),
                radial-gradient(circle at 86% 12%, rgba(52, 152, 219, 0.20), transparent 26%),
                linear-gradient(135deg, #2b2116 0%, #181818 54%, #151f2a 100%);
    }

    .game-topbar {
        align-items: center;
        display: flex;
        gap: 16px;
        justify-content: space-between;
        margin-bottom: 28px;
    }

    .question-pill,
    .category-pill {
        border-radius: 999px;
        font-weight: 700;
        letter-spacing: 1px;
        padding: 10px 14px;
        text-transform: uppercase;
    }

    .question-pill {
        background: rgba(212, 175, 55, 0.16);
        border: 1px solid rgba(212, 175, 55, 0.5);
        color: #f6d365;
        font-family: 'Cinzel', serif;
    }

    .category-pill {
        background: rgba(52, 152, 219, 0.14);
        border: 1px solid rgba(52, 152, 219, 0.42);
        color: #9fd3ff;
        font-size: 0.82em;
    }

    .question-card {
        background: linear-gradient(180deg, rgba(47, 47, 47, 0.96), rgba(26, 26, 26, 0.98));
        border: 1px solid rgba(255, 255, 255, 0.10);
        border-radius: 24px;
        box-shadow: 0 20px 48px rgba(0, 0, 0, 0.36);
        padding: 32px;
    }

    .question-card h2 {
        color: #fff;
        font-size: clamp(1.7em, 4vw, 3em);
        line-height: 1.18;
        margin: 0;
        text-align: center;
        text-transform: none;
    }

    .question-helper {
        color: #bdbdbd;
        margin: 16px auto 0;
        max-width: 620px;
        text-align: center;
    }

    .answer-grid {
        display: grid;
        gap: 16px;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        margin-top: 30px;
    }

    .answer-option {
        align-items: center;
        background: rgba(255, 255, 255, 0.055);
        border: 1px solid rgba(255, 255, 255, 0.10);
        border-radius: 18px;
        color: #f5f5f5;
        cursor: pointer;
        display: grid;
        font-size: 1.02em;
        gap: 14px;
        grid-template-columns: auto 1fr;
        padding: 18px;
        text-align: left;
        transition: transform 0.2s, border-color 0.2s, background 0.2s;
        width: 100%;
    }

    .answer-option:hover {
        background: rgba(212, 175, 55, 0.12);
        border-color: rgba(212, 175, 55, 0.62);
        transform: translateY(-2px);
    }

    .answer-letter {
        align-items: center;
        background: #d4af37;
        border-radius: 14px;
        color: #1a1a1a;
        display: inline-flex;
        font-family: 'Cinzel', serif;
        font-size: 1.1em;
        font-weight: 700;
        height: 42px;
        justify-content: center;
        width: 42px;
    }

    .game-footer {
        align-items: center;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
        display: flex;
        gap: 18px;
        justify-content: space-between;
        margin-top: 28px;
        padding-top: 22px;
    }

    .score-preview {
        color: #d4af37;
        font-family: 'Cinzel', serif;
        font-weight: 700;
        letter-spacing: 1px;
        text-transform: uppercase;
    }

    .progress-track {
        background: rgba(255, 255, 255, 0.10);
        border-radius: 999px;
        flex: 1;
        height: 10px;
        max-width: 320px;
        overflow: hidden;
    }

    .progress-fill {
        background: linear-gradient(90deg, #c0392b, #d4af37);
        border-radius: inherit;
        height: 100%;
        width: 10%;
    }

    @media (max-width: 720px) {
        .question-stage,
        .question-card {
            padding: 22px;
        }

        .game-topbar,
        .game-footer {
            align-items: stretch;
            flex-direction: column;
        }

        .answer-grid {
            grid-template-columns: 1fr;
        }

        .progress-track {
            max-width: none;
            width: 100%;
        }
    }
</style>

<main class="container game-shell">
    <section class="question-stage">
        <div class="game-topbar">
            <span class="question-pill">Pregunta numero 1 de 10</span>
            <span class="category-pill">Cultura general</span>
        </div>

        <article class="question-card">
            <h2>&iquest;Cu&aacute;l es el planeta m&aacute;s grande del sistema solar?</h2>
            <p class="question-helper">Eleg&iacute; una respuesta para avanzar a la siguiente pregunta.</p>

            <form class="answer-grid" action="#" method="post">
                <button class="answer-option" type="button">
                    <span class="answer-letter">A</span>
                    <span>Marte</span>
                </button>

                <button class="answer-option" type="button">
                    <span class="answer-letter">B</span>
                    <span>J&uacute;piter</span>
                </button>

                <button class="answer-option" type="button">
                    <span class="answer-letter">C</span>
                    <span>Saturno</span>
                </button>

                <button class="answer-option" type="button">
                    <span class="answer-letter">D</span>
                    <span>Neptuno</span>
                </button>
            </form>

            <div class="game-footer">
                <span class="score-preview">Puntaje: 0</span>
                <div class="progress-track" aria-label="Progreso de la partida">
                    <div class="progress-fill"></div>
                </div>
            </div>
        </article>
    </section>
</main>

{{>footer}}
