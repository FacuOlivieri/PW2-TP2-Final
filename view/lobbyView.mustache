{{>header}}
{{>lobbyCss}}

<main class="container lobby-shell">
    <section class="lobby-hero">
        <div class="lobby-hero-top">
            <div>
                <p class="lobby-kicker">Lobby de jugador</p>
                <h2 class="lobby-title">
                    {{#nombreUsuario}}{{nombreUsuario}}{{/nombreUsuario}}{{^nombreUsuario}}Jugador{{/nombreUsuario}}
                    <span>{{#puntajeRanking}}{{puntajeRanking}}{{/puntajeRanking}}{{^puntajeRanking}}0{{/puntajeRanking}} puntos en ranking</span>
                </h2>
            </div>

            {{#es_usuario_comun}}
                <a href="/partida/iniciarPartida" class="btn-add lobby-primary-action">
                    Crear nueva partida
                </a>
            {{/es_usuario_comun}}
        </div>

        {{#es_usuario_comun}}
            <div class="lobby-summary">
                <article class="lobby-stat">
                    <strong>{{#puntajeRanking}}{{puntajeRanking}}{{/puntajeRanking}}{{^puntajeRanking}}0{{/puntajeRanking}}</strong>
                    <span>Puntos acumulados</span>
                </article>
                <article class="lobby-stat">
                    <strong>#{{#puestoRanking}}{{puestoRanking}}{{/puestoRanking}}{{^puestoRanking}}--{{/puestoRanking}}</strong>
                    <span>Posicion en ranking</span>
                </article>
                <article class="lobby-stat">
                    <strong>{{#partidasTotales}}{{partidasTotales}}{{/partidasTotales}}{{^partidasTotales}}0{{/partidasTotales}}</strong>
                    <span>Partidas jugadas</span>
                </article>
            </div>
        {{/es_usuario_comun}}

        <div class="lobby-actions">
            {{#es_usuario_comun}}
                <a href="/usuario/ranking" class="btn-secondary">
                    Ver ranking
                </a>

                <a href="/usuario/perfil" class="btn-secondary">
                    Mi perfil
                </a>

                <a href="/usuario/historial" class="btn-secondary">
                    Historial
                </a>
            {{/es_usuario_comun}}

                {{#puede_sugerir_pregunta}}
                    <a href="/preguntaCreada/crear" class="btn-secondary">
                         Crear Pregunta
                    </a>
                {{/puede_sugerir_pregunta}}

                {{#es_admin}}
                <a href="/administrador/verDashboard" class="btn-secondary">
                    Ver Analíticas
                </a>
                {{/es_admin}}

                {{#es_editor}}
                <a href="/preguntaCreada/propuestas" class="btn-secondary" style="position: relative;">
                    Preguntas Propuestas
                    {{#pendientes_preguntas}}
                        <span style="position: absolute; top: -8px; right: -8px; background: #e74c3c; color: white; border-radius: 50%; width: 20px; height: 20px; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: bold;">{{pendientes_preguntas}}</span>
                    {{/pendientes_preguntas}}
                </a>
                {{/es_editor}}

                {{#es_admin}}
                {{^es_editor}}
                <a href="/preguntaCreada/propuestas" class="btn-secondary" style="position: relative;">
                    Preguntas Propuestas
                    {{#pendientes_preguntas}}
                        <span style="position: absolute; top: -8px; right: -8px; background: #e74c3c; color: white; border-radius: 50%; width: 20px; height: 20px; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: bold;">{{pendientes_preguntas}}</span>
                    {{/pendientes_preguntas}}
                </a>
                {{/es_editor}}
                {{/es_admin}}

                {{#es_editor}}
                <a href="/editor/preguntas" class="btn-secondary">
                    Panel Editor
                </a>
                <a href="/editor/reportes" class="btn-secondary">
                    Preguntas Reportadas
                </a>
                {{/es_editor}}

            <a href="/usuario/cerrarSesion" class="btn-secondary">
                Cerrar sesión
            </a>
        </div>
    </section>

    {{#es_usuario_comun}}
    <section class="lobby-content">
        <article class="lobby-card">
            <div class="lobby-card-header">
                <div>
                    <h3>Mis partidas</h3>
                    <p>Listado de partidas jugadas y el resultado obtenido.</p>
                </div>
                <span class="lobby-badge">Historial</span>
            </div>

            <div class="match-list">

                {{#partidasJugadas}}
                    <article class="match-item">
                        <div>
                            <h4>Partida #{{id}}</h4>
                            <p>{{fecha_creacion}} &middot; {{puntaje_total}} puntos</p>
                        </div>
                        <span class="match-result win">Finalizada</span>
                    </article>
                {{/partidasJugadas}}

                {{^partidasJugadas}}
                    <article class="match-item">
                        <div>
                            <h4>Sin partidas jugadas</h4>
                            <p>Todavía no terminaste ninguna partida.</p>
                        </div>
                        <span class="match-result pending">Pendiente</span>
                    </article>
                {{/partidasJugadas}}
                
            </div>
        </article>

        <article class="lobby-card" id="ranking">
            <div class="lobby-card-header">
                <div>
                    <h3>Ranking general</h3>
                    <p>Puntajes acumulados totales de todos los jugadores.</p>
                </div>
                <span class="lobby-badge">Top jugadores</span>
            </div>

            <div class="ranking-table-scroll">
                <table class="ranking-table">
                    <thead>
                    <tr>
                        <th>Pos.</th>
                        <th>Jugador</th>
                        <th>Total</th>
                    </tr>
                    </thead>
                    <tbody>
                    {{#ranking}}
                        <tr>
                            <td class="ranking-position">#{{puesto}}</td>
                            <td>{{nombre}}</td>
                            <td>{{puntajeTotal}}</td>
                        </tr>
                    {{/ranking}}

                    {{^ranking}}
                        <tr>
                            <td class="ranking-position">#1</td>
                            <td>Valentina</td>
                            <td>2.430</td>
                        </tr>
                        <tr>
                            <td class="ranking-position">#2</td>
                            <td>Mateo</td>
                            <td>2.110</td>
                        </tr>
                        <tr>
                            <td class="ranking-position">#3</td>
                            <td>Sofia</td>
                            <td>1.980</td>
                        </tr>
                        <tr>
                            <td class="ranking-position">#4</td>
                            <td>Jugador</td>
                            <td>0</td>
                        </tr>
                    {{/ranking}}
                    </tbody>
                </table>
            </div>
        </article>
    </section>
    {{/es_usuario_comun}}
</main>
{{>footer}}
