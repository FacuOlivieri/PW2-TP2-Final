{{>header}}
<main class="container">
    {{#reporte}}
        <section class="report-detail-card">
            <div class="report-detail-header">
                <div>
                    <p class="lobby-kicker">Reporte pendiente</p>
                    <h2 class="form-title">{{pregunta}}</h2>
                </div>
                <span class="estado-badge estado-{{estado_reporte}}">{{estado_reporte}}</span>
            </div>

            <div class="report-detail-meta">
                <article><strong>Categoría</strong><span>{{categoria}}</span></article>
                <article><strong>Reportado por</strong><span>{{usuario}}</span></article>
                <article><strong>Fecha</strong><span>{{fecha}}</span></article>
                <article><strong>Motivo</strong><span>{{motivo}}</span></article>
                <article class="meta-wide"><strong>Comentario</strong><span>{{#comentario}}{{comentario}}{{/comentario}}{{^comentario}}Sin comentario adicional{{/comentario}}</span></article>
            </div>

            <h3 class="report-detail-subtitle">Respuestas</h3>
            <div class="report-answer-grid">
                {{#respuestas}}
                    <article class="report-answer-card {{#es_correcta_bool}}correct-answer{{/es_correcta_bool}}">
                        <span>{{texto}}</span>
                        {{#es_correcta_bool}}<strong>Respuesta correcta</strong>{{/es_correcta_bool}}
                    </article>
                {{/respuestas}}
            </div>

            <div class="report-detail-actions">
                {{#esPendiente}}
                    <form action="/editor/resolverReporte" method="POST">
                        <input type="hidden" name="id" value="{{id}}">
                        <input type="hidden" name="estado" value="rechazada">
                        <button type="submit" class="btn-secondary btn-aprobar">Mantener pregunta</button>
                    </form>
                    <form action="/editor/resolverReporte" method="POST">
                        <input type="hidden" name="id" value="{{id}}">
                        <input type="hidden" name="estado" value="aprobada">
                        <button type="submit" class="btn-secondary btn-rechazar">Dar de baja pregunta</button>
                    </form>
                {{/esPendiente}}
                <a href="/editor/reportes" class="back-link">Volver al listado</a>
            </div>
        </section>
    {{/reporte}}
</main>

<style>
    .report-detail-card {
        background: #ffffff;
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-soft);
        margin: 0 auto;
        max-width: 960px;
        padding: 30px;
    }

    .report-detail-header {
        align-items: flex-start;
        display: flex;
        gap: 16px;
        justify-content: space-between;
        margin-bottom: 22px;
    }

    .report-detail-header .form-title {
        margin: 0;
        text-align: left;
    }

    .report-detail-meta {
        display: grid;
        gap: 14px;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        margin-bottom: 24px;
    }

    .report-detail-meta article {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius-sm);
        padding: 14px;
    }

    .report-detail-meta .meta-wide {
        grid-column: span 2;
    }

    .report-detail-meta strong,
    .report-detail-meta span {
        display: block;
    }

    .report-detail-meta strong {
        color: var(--primary);
        font-size: 0.78rem;
        letter-spacing: 0.08em;
        margin-bottom: 5px;
        text-transform: uppercase;
    }

    .report-detail-subtitle {
        margin: 0 0 14px;
    }

    .report-answer-grid {
        display: grid;
        gap: 12px;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        margin-bottom: 26px;
    }

    .report-answer-card {
        background: #ffffff;
        border: 1px solid var(--border);
        border-radius: var(--radius-sm);
        color: var(--muted);
        padding: 16px;
    }

    .report-answer-card.correct-answer {
        background: #ecfdf5;
        border-color: #a7f3d0;
        color: var(--success);
        font-weight: 800;
    }

    .report-answer-card strong {
        display: block;
        font-size: 0.75rem;
        letter-spacing: 0.06em;
        margin-top: 6px;
        text-transform: uppercase;
    }

    .report-detail-actions {
        align-items: center;
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
    }

    .report-detail-actions form {
        margin: 0;
    }

    .report-detail-actions button {
        cursor: pointer;
    }

    .report-detail-actions .back-link {
        margin-top: 0;
    }

    .btn-aprobar {
        background: #ecfdf5;
        border: 1px solid #a7f3d0;
        color: var(--success);
    }

    .btn-rechazar {
        background: #fef2f2;
        border: 1px solid #fecaca;
        color: var(--danger);
    }

    .estado-badge {
        border-radius: 999px;
        display: inline-block;
        font-size: 0.78rem;
        font-weight: 800;
        padding: 5px 12px;
        text-transform: capitalize;
        white-space: nowrap;
    }

    .estado-pendiente {
        background: var(--soft-amber);
        border: 1px solid #fde68a;
        color: #92400e;
    }

    @media (max-width: 760px) {
        .report-detail-header,
        .report-detail-actions {
            align-items: stretch;
            flex-direction: column;
        }

        .report-detail-meta,
        .report-answer-grid {
            grid-template-columns: 1fr;
        }

        .report-detail-meta .meta-wide {
            grid-column: auto;
        }
    }
</style>
{{>footer}}
