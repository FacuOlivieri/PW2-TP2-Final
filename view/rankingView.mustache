{{> header}}

<div class="container">

    <div class="welcome-panel">
        <h2> Ranking </h2>
        <p> Los jugadores con mayor sabiduría del reino </p>
    </div>

    <div class="home-actions">

        <a href="/usuario/perfil" class="btn-add">
            Mi Perfil
        </a>

        <a href="/usuario/mostrarUsuarioLobby" class="btn-secondary">
            Volver al Lobby
        </a>
    </div>

    <div class="ranking-scroll table-scroll-panel">
        <table>
            <thead>
                <tr>
                    <th>Puesto</th>
                    <th>Jugador</th>
                    <th>Puntaje</th>
                </tr>
            </thead>

            <tbody>
                {{#ranking}}
                <tr>
                    <td>#{{puesto}}</td>
                    <td><a class="table-link" href="/usuario/perfil?username={{nombre}}">{{nombre}}</a></td>
                    <td>{{puntajeTotal}}</td>
                </tr>
                {{/ranking}}
            </tbody>
        </table>
    </div>
</div>

<style>
    .table-scroll-panel {
        border: 1px solid var(--border);
        border-radius: var(--radius-md);
        margin-top: 22px;
        max-height: 560px;
        overflow: auto;
        scrollbar-width: thin;
    }

    .table-scroll-panel table {
        display: table;
        margin: 0;
        white-space: normal;
    }

    .table-scroll-panel th {
        position: sticky;
        top: 0;
        z-index: 1;
    }
</style>

{{>footer}}
