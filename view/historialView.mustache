{{> header}}

<div class="container">

    <div class="welcome-panel">
        <h2>Historial</h2>
        <p> Revisá todas tus partidas jugadas </p>
    </div>

    <div class="home-actions">

        <a href="/usuario/perfil" class="btn-add">
            Mi Perfil
        </a>

        <a href="/usuario/mostrarUsuarioLobby" class="btn-secondary">
            Volver al Lobby
        </a>
    </div>

    <div class="historial-scroll table-scroll-panel">
        <table>
            <thead>
                <tr>
                    <th>Partida</th>
                    <th>Preguntas Respondidas</th>
                    <th>Puntaje</th>
                    <th>Estado</th>
                </tr>
            </thead>

            <tbody>
                {{#historial}}
                <tr>
                    <td>#{{id}}</td>
                    <td>{{preguntas_jugadas}}</td>
                    <td>{{puntaje_total}}</td>
                    <td>Finalizada</td>
                </tr>
                {{/historial}}
            </tbody>
        </table>
    </div>
</div>

<style>
    .table-scroll-panel {
        border: 1px solid var(--border);
        border-radius: var(--radius-md);
        margin-top: 22px;
        max-height: 560px;
        overflow: auto;
        scrollbar-width: thin;
    }

    .table-scroll-panel table {
        display: table;
        margin: 0;
        white-space: normal;
    }

    .table-scroll-panel th {
        position: sticky;
        top: 0;
        z-index: 1;
    }
</style>

{{>footer}}
