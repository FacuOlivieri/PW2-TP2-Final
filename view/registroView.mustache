{{>header}}
<main class="container">
    <div class="form-container">
        <h2 class="form-title">Crear cuenta</h2>
        <p class="form-help">Completá tus datos para registrarte.</p>

        {{#error}}
            <p class="form-error">{{error}}</p>
        {{/error}}

        <form action="/usuarios/procesarRegistro" method="POST" enctype="multipart/form-data" id="registro-form">
            <div class="form-group">
                <label>Nombre Completo</label>
                <input type="text" name="nombre_completo" value="{{nombre_completo}}" required>
            </div>

            <div class="form-group">
                <label>Año de Nacimiento</label>
                <input type="number" name="anio_nacimiento" min="1900" max="2026" value="{{anio_nacimiento}}" required>
            </div>

            <div class="form-group">
                <label>Sexo</label>
                <select name="sexo" required>
                    <option value="">Seleccionar</option>
                    <option value="Masculino" {{#sexo_masculino}}selected{{/sexo_masculino}}>Masculino</option>
                    <option value="Femenino" {{#sexo_femenino}}selected{{/sexo_femenino}}>Femenino</option>
                    <option value="Prefiero no cargarlo" {{#sexo_prefiero_no_cargarlo}}selected{{/sexo_prefiero_no_cargarlo}}>Prefiero no cargarlo</option>
                </select>
            </div>

            <div class="map-picker">
                <div class="map-picker-header">
                    <h3>Ubicación</h3>
                    <p>Hace clic en el mapa para completar el país y la ciudad.</p>
                </div>
                <div id="registro-map" class="location-map"></div>
                <p id="location-status" class="location-status">Todavía no seleccionaste una ubicación.</p>
            </div>

            <div class="location-grid">
                <div class="form-group">
                    <label>País</label>
                    <input type="text" name="pais" id="pais" value="{{pais}}" readonly required>
                </div>

                <div class="form-group">
                    <label>Ciudad</label>
                    <input type="text" name="ciudad" id="ciudad" value="{{ciudad}}" readonly required>
                </div>
            </div>

            <div class="form-group">
                <label>Mail</label>
                <input type="email" name="mail" value="{{mail}}" required>
            </div>

            <div class="form-group">
                <label>Nombre de Usuario</label>
                <input type="text" name="username" value="{{username}}" required>
            </div>

            <div class="form-group">
                <label>Contraseña</label>
                <input type="password" name="password" required>
            </div>

            <div class="form-group">
                <label>Repetir Contraseña</label>
                <input type="password" name="repetir_password" required>
            </div>

            <div class="form-group">
                <label>Foto de Perfil</label>
                <input type="file" name="foto_perfil" accept="image/*">
            </div>

            <button type="submit" class="btn-submit">Registrarse</button>
            <a href="/usuarios/iniciarSesion" class="back-link">Ya tengo cuenta</a>
        </form>
    </div>
</main>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
    (function () {
        const mapElement = document.getElementById('registro-map');

        if (!mapElement || typeof L === 'undefined') {
            return;
        }

        const form = document.getElementById('registro-form');
        const countryInput = document.getElementById('pais');
        const cityInput = document.getElementById('ciudad');
        const status = document.getElementById('location-status');
        const initialPosition = [-34.6037, -58.3816];
        let marker = null;

        const map = L.map(mapElement).setView(initialPosition, 4);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; OpenStreetMap',
            maxZoom: 19
        }).addTo(map);

        function setStatus(message, isError) {
            status.textContent = message;
            status.classList.toggle('location-status-error', isError);
        }

        function resolveCity(address) {
            return address.city
                || address.town
                || address.village
                || address.municipality
                || address.hamlet
                || address.locality
                || '';
        }

        async function selectLocation(latlng) {
            countryInput.value = '';
            cityInput.value = '';
            setStatus('Buscando país y ciudad...', false);

            if (marker) {
                marker.setLatLng(latlng);
            } else {
                marker = L.marker(latlng).addTo(map);
            }

            try {
                const params = new URLSearchParams({
                    format: 'jsonv2',
                    lat: latlng.lat,
                    lon: latlng.lng,
                    zoom: '10',
                    addressdetails: '1',
                    'accept-language': 'es'
                });

                const response = await fetch('https://nominatim.openstreetmap.org/reverse?' + params.toString());

                if (!response.ok) {
                    throw new Error('No se pudo consultar la ubicación.');
                }

                const data = await response.json();
                const address = data.address || {};
                const country = address.country || '';
                const city = resolveCity(address);

                if (!country || !city) {
                    setStatus('No se pudo detectar la ciudad. Elegí un punto más cercano a una zona urbana.', true);
                    return;
                }

                countryInput.value = country;
                cityInput.value = city;
                setStatus('Ubicación seleccionada: ' + city + ', ' + country + '.', false);
            } catch (error) {
                setStatus('No se pudo obtener la ubicación. Revisá tu conexión o intentá con otro punto del mapa.', true);
            }
        }

        map.on('click', function (event) {
            selectLocation(event.latlng);
        });

        form.addEventListener('submit', function (event) {
            if (!countryInput.value || !cityInput.value) {
                event.preventDefault();
                setStatus('Seleccioná país y ciudad haciendo clic en el mapa antes de registrarte.', true);
                mapElement.scrollIntoView({behavior: 'smooth', block: 'center'});
            }
        });
    })();
</script>
{{>footer}}
