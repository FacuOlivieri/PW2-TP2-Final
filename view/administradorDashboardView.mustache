{{>administradorDashboardCss}}
<main class="dashboard-shell">

    <header class="dashboard-hero">
        <div class="dashboard-hero-top">
            <div class="dashboard-branding">
                <p class="dashboard-kicker">Panel de Control</p>
                <h1 class="dashboard-title">
                    Dashboard de Administración
                    <span>Monitoreo global de métricas y rendimiento</span>
                </h1>
            </div>
            <button class="btn-print" onclick="window.print()">
                Imprimir Reporte
            </button>
        </div>

        <div class="dashboard-actions">
            <a href="?filtrar=dia" class="btn-filter {{#filtro_dia}}active{{/filtro_dia}}">Día</a>
            <a href="?filtrar=semana" class="btn-filter {{#filtro_semana}}active{{/filtro_semana}}">Semana</a>
            <a href="?filtrar=anio" class="btn-filter {{#filtro_anio}}active{{/filtro_anio}}">Año</a>
        </div>
    </header>

    <div class="dashboard-content">

        <section class="dashboard-section">
            <h2 class="section-title">Gestión de Jugadores</h2>

            <div class="metrics-summary">
                <div class="metric-stat">
                    <strong>{{totalJugadores}}</strong>
                    <span>Total Jugadores</span>
                </div>
                <div class="metric-stat">
                    <strong>{{jugadoresNuevos}}</strong>
                    <span>Jugadores Nuevos</span>
                </div>
                <div class="metric-stat-action">
                    <a href="#" class="btn-view-users">Ver Usuarios</a>
                </div>
            </div>

            <div class="tables-grid">

                <div class="data-card">
                    <div class="data-card-header">
                        <div>
                            <h3>Jugadores por País</h3>
                            <p>Distribución geográfica</p>
                        </div>
                        <span class="data-badge">Países</span>
                    </div>
                    <table class="data-table">
                        <thead>
                        <tr>
                            <th>País</th>
                            <th>Usuarios</th>
                        </tr>
                        </thead>
                        <tbody>
                        {{#jugadoresPorPais}}
                            <tr><td class="row-highlight">{{pais}}</td><td>{{cantidad}}</td></tr>
                        {{/jugadoresPorPais}}
                        </tbody>
                    </table>
                </div>

                <div class="data-card">
                    <div class="data-card-header">
                        <div>
                            <h3>Jugadores por Sexo</h3>
                            <p>Identificación de género</p>
                        </div>
                        <span class="data-badge">Demografía</span>
                    </div>
                    <table class="data-table">
                        <thead>
                        <tr>
                            <th>Sexo</th>
                            <th>Usuarios</th>
                        </tr>
                        </thead>
                        <tbody>
                        {{#jugadoresPorSexo}}
                            <tr><td class="row-highlight">{{sexo}}</td><td>{{cantidad}}</td></tr>
                        {{/jugadoresPorSexo}}
                        </tbody>
                    </table>
                </div>

                <div class="data-card">
                    <div class="data-card-header">
                        <div>
                            <h3>Grupo de Edad</h3>
                            <p>Segmentación por rangos</p>
                        </div>
                        <span class="data-badge">Edades</span>
                    </div>
                    <table class="data-table">
                        <thead>
                        <tr>
                            <th>Grupo</th>
                            <th>Usuarios</th>
                        </tr>
                        </thead>
                        <tbody>
                        {{#jugadoresPorEdad}}
                            <tr><td class="row-highlight">{{rango}}</td><td>{{cantidad}}</td></tr>
                        {{/jugadoresPorEdad}}
                        </tbody>
                    </table>
                </div>

            </div>
        </section>

        <section class="dashboard-section">
            <h2 class="section-title">Partidas y Preguntas</h2>

            <div class="metrics-summary">
                <div class="metric-stat">
                    <strong>{{partidasJugadas}}</strong>
                    <span>🎮 Partidas Jugadas</span>
                </div>
                <div class="metric-stat">
                    <strong>{{totalPreguntas}}</strong>
                    <span>📚 Preguntas Activas</span>
                </div>
                <div class="metric-stat">
                    <strong>{{totalPreguntasCreadas}}</strong>
                    <span>✍️ Preguntas Creadas</span>
                </div>
            </div>
        </section>

    </div>
    <footer class="dashboard-footer">
        <a href="/usuario/renderizarLobby" class="btn-back">
            Volver al Lobby
        </a>
    </footer>
    </div>
</main>