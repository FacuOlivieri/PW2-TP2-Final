<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Preguntados</title>
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">

    <style>
        :root {
            --bg: #f8f9ff;
            --card: #ffffff;
            --text: #1f2937;
            --muted: #6b7280;
            --primary: #7c3aed;
            --primary-dark: #6d28d9;
            --secondary: #6366f1;
            --accent: #f59e0b;
            --border: #e5e7eb;
            --soft-purple: #f5f3ff;
            --soft-indigo: #eef2ff;
            --soft-amber: #fffbeb;
            --danger: #dc2626;
            --success: #059669;
            --shadow-sm: 0 7px 18px rgba(31, 41, 55, 0.07);
            --shadow-md: 0 14px 38px rgba(31, 41, 55, 0.10);
            --radius-sm: 12px;
            --radius-md: 20px;
            --radius-lg: 26px;
        }

        * {
            box-sizing: border-box;
        }

        body {
            background:
                    radial-gradient(circle at 12% 8%, rgba(124, 58, 237, 0.07), transparent 24%),
                    radial-gradient(circle at 88% 12%, rgba(245, 158, 11, 0.08), transparent 22%),
                    var(--bg);
            color: var(--text);
            display: flex;
            flex-direction: column;
            font-family: 'Open Sans', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            margin: 0;
            min-height: 100vh;
            padding: 0;
        }

        a {
            color: inherit;
        }

        h1, h2, h3, h4, p {
            overflow-wrap: anywhere;
        }

        h1, h2, th, .btn-add {
            font-family: 'Open Sans', sans-serif;
            letter-spacing: -0.02em;
            text-transform: none;
        }

        header {
            align-items: center;
            background:
                    linear-gradient(135deg, rgba(124, 58, 237, 0.10), rgba(99, 102, 241, 0.08) 48%, rgba(245, 158, 11, 0.10)),
                    #ffffff;
            border-bottom: 1px solid rgba(229, 231, 235, 0.9);
            box-shadow: 0 10px 28px rgba(31, 41, 55, 0.06);
            display: flex;
            flex-direction: column;
            height: 218px;
            justify-content: center;
            overflow: hidden;
            padding: 24px 18px;
            position: relative;
            text-align: center;
            flex-shrink: 0;
        }

        header::before,
        header::after {
            border-radius: 999px;
            content: "";
            position: absolute;
        }

        header::before {
            background: rgba(124, 58, 237, 0.06);
            height: 112px;
            left: -48px;
            top: 34px;
            width: 112px;
        }

        header::after {
            background: rgba(245, 158, 11, 0.08);
            bottom: -58px;
            height: 148px;
            right: 8%;
            width: 148px;
        }

        header h1 {
            color: var(--text);
            font-size: clamp(2.15rem, 6.4vw, 4.1rem);
            font-weight: 800;
            line-height: 0.95;
            margin: 0;
            position: relative;
            z-index: 1;
        }

        header p {
            background: rgba(255, 255, 255, 0.76);
            border: 1px solid var(--border);
            border-radius: 999px;
            color: var(--muted);
            font-size: 1rem;
            font-style: normal;
            font-weight: 700;
            margin: 14px 0 0;
            padding: 9px 16px;
            position: relative;
            z-index: 1;
        }

        .container {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-md);
            margin: -38px auto 48px;
            max-width: 1080px;
            padding: clamp(20px, 3.5vw, 32px);
            flex: 1 0 auto;
            position: relative;
            width: min(92%, 1080px);
            z-index: 2;
        }

        .form-container {
            margin: 0 auto;
            max-width: 680px;
        }

        .title,
        .form-title,
        .welcome-panel h2 {
            color: var(--text);
            font-size: clamp(1.7rem, 4.5vw, 2.65rem);
            font-weight: 800;
            line-height: 1.05;
            margin: 0 0 12px;
            text-align: center;
        }

        .welcome-panel {
            padding: 8px 8px 20px;
            text-align: center;
        }

        .welcome-panel p,
        .form-help {
            color: var(--muted);
            font-size: 1rem;
            line-height: 1.65;
            margin: 0 auto 24px;
            max-width: 700px;
            text-align: center;
        }

        .form-error {
            background: #fef2f2;
            border: 1px solid #fecaca;
            border-radius: var(--radius-sm);
            color: var(--danger);
            font-weight: 700;
            margin: 0 0 20px;
            padding: 13px 16px;
            text-align: center;
        }

        .form-group {
            margin-bottom: 16px;
        }

        .form-group label {
            color: var(--text);
            display: block;
            font-size: 0.82rem;
            font-weight: 800;
            letter-spacing: 0.04em;
            margin-bottom: 8px;
            text-transform: uppercase;
        }

        .form-group input,
        .form-group select {
            background: #ffffff;
            border: 1px solid var(--border);
            border-radius: 16px;
            color: var(--text);
            font-size: 1rem;
            min-height: 46px;
            padding: 11px 14px;
            transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s;
            width: 100%;
        }

        .form-group input:focus,
        .form-group select:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 4px rgba(124, 58, 237, 0.12);
            outline: none;
            transform: translateY(-1px);
        }

        .form-group input[readonly] {
            background-color: var(--soft-purple);
            color: var(--primary-dark);
            cursor: default;
            font-weight: 700;
        }

        .btn-add,
        .btn-submit,
        .btn-secondary,
        .primary-btn,
        .secondary-btn,
        .actions a {
            align-items: center;
            border-radius: 14px;
            display: inline-flex;
            font-family: 'Open Sans', sans-serif;
            font-weight: 800;
            justify-content: center;
            line-height: 1.2;
            text-decoration: none;
            transition: transform 0.2s, box-shadow 0.2s, background 0.2s, border-color 0.2s, color 0.2s;
        }

        .btn-add,
        .btn-submit,
        .primary-btn {
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            border: 0;
            box-shadow: 0 12px 24px rgba(124, 58, 237, 0.20);
            color: #ffffff;
        }

        .btn-add,
        .btn-secondary,
        .primary-btn,
        .secondary-btn {
            padding: 12px 21px;
        }

        .btn-add {
            margin-bottom: 20px;
        }

        .btn-submit {
            cursor: pointer;
            font-size: 1rem;
            margin-top: 8px;
            padding: 13px 18px;
            text-transform: uppercase;
            width: 100%;
        }

        .btn-secondary,
        .secondary-btn {
            background: #ffffff;
            border: 1px solid var(--border);
            box-shadow: var(--shadow-sm);
            color: var(--primary);
        }

        .btn-add:hover,
        .btn-submit:hover,
        .btn-secondary:hover,
        .primary-btn:hover,
        .secondary-btn:hover,
        .actions a:hover {
            transform: translateY(-2px);
        }

        .btn-add:hover,
        .btn-submit:hover,
        .primary-btn:hover {
            box-shadow: 0 16px 30px rgba(124, 58, 237, 0.25);
        }

        .btn-secondary:hover,
        .secondary-btn:hover {
            background: var(--soft-purple);
            border-color: #ddd6fe;
            color: var(--primary-dark);
        }

        .back-link {
            color: var(--primary);
            display: block;
            font-size: 0.95rem;
            font-weight: 800;
            margin-top: 20px;
            text-align: center;
            text-decoration: none;
        }

        .back-link:hover {
            color: var(--secondary);
        }

        .home-actions {
            align-items: center;
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            justify-content: center;
            margin-top: 10px;
        }

        .home-actions .btn-add,
        .home-actions .btn-secondary {
            box-sizing: border-box;
            margin: 0;
            min-width: 190px;
            text-align: center;
        }

        table {
            background: #ffffff;
            border: 1px solid var(--border);
            border-collapse: separate;
            border-radius: var(--radius-md);
            border-spacing: 0;
            box-shadow: var(--shadow-sm);
            overflow: hidden;
            width: 100%;
        }

        th,
        td {
            border-bottom: 1px solid var(--border);
            color: var(--text);
            padding: 14px 16px;
            text-align: left;
        }

        th {
            background: var(--soft-indigo);
            color: #4338ca;
            font-size: 0.8rem;
            font-weight: 800;
            letter-spacing: 0.05em;
            text-transform: uppercase;
        }

        tr:last-child td {
            border-bottom: 0;
        }

        tr:hover td {
            background: #fbfbff;
        }

        .actions a {
            font-size: 0.85rem;
            margin: 3px 5px 3px 0;
            padding: 8px 13px;
        }

        .table-link {
            color: var(--primary);
            font-weight: 800;
            text-decoration: none;
        }

        .table-link:hover {
            color: var(--secondary);
            text-decoration: underline;
        }

        .profile-map-card {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: var(--radius-md);
            box-shadow: var(--shadow-sm);
            margin-top: 22px;
            overflow: hidden;
        }

        .profile-public-grid {
            display: grid;
            gap: 16px;
            grid-template-columns: minmax(0, 1fr) minmax(260px, 0.45fr);
            margin-bottom: 22px;
        }

        .profile-summary-card,
        .profile-qr-card,
        .profile-matches-card {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: var(--radius-md);
            box-shadow: var(--shadow-sm);
        }

        .profile-summary-card,
        .profile-qr-card {
            align-items: center;
            display: flex;
            gap: 16px;
            padding: 18px;
        }

        .profile-photo {
            border: 1px solid var(--border);
            border-radius: 22px;
            flex: 0 0 auto;
            height: 96px;
            object-fit: cover;
            width: 96px;
        }

        .profile-photo-placeholder {
            align-items: center;
            background: linear-gradient(135deg, var(--soft-purple), var(--soft-indigo));
            color: var(--primary-dark);
            display: flex;
            font-size: 0.9rem;
            font-weight: 800;
            justify-content: center;
            overflow: hidden;
            padding: 8px;
            text-align: center;
        }

        .profile-label {
            color: var(--primary);
            display: block;
            font-size: 0.78rem;
            font-weight: 800;
            letter-spacing: 0.06em;
            margin-bottom: 6px;
            text-transform: uppercase;
        }

        .profile-summary-card h3 {
            color: var(--text);
            font-size: clamp(1.35rem, 3vw, 2rem);
            line-height: 1.1;
            margin: 0 0 6px;
        }

        .profile-summary-card p,
        .profile-qr-card p {
            color: var(--muted);
            line-height: 1.5;
            margin: 0;
        }

        .profile-qr-card img {
            border: 1px solid var(--border);
            border-radius: 16px;
            height: 112px;
            width: 112px;
        }

        .profile-map-header {
            padding: 16px 18px 12px;
        }

        .profile-map-header h3 {
            color: var(--text);
            font-size: 1.05rem;
            font-weight: 800;
            margin: 0 0 5px;
        }

        .profile-map-header p {
            color: var(--muted);
            margin: 0;
        }

        .profile-map {
            border: 0;
            display: block;
            height: 300px;
            width: 100%;
        }

        .profile-matches-card {
            margin-top: 22px;
            overflow: hidden;
        }

        .profile-match-list {
            display: grid;
            gap: 12px;
            padding: 0 18px 18px;
        }

        .profile-match-item {
            align-items: center;
            background: #fbfbff;
            border: 1px solid var(--border);
            border-radius: 16px;
            display: flex;
            gap: 14px;
            justify-content: space-between;
            padding: 14px;
        }

        .profile-match-item h4 {
            color: var(--text);
            margin: 0 0 5px;
        }

        .profile-match-item p {
            color: var(--muted);
            margin: 0;
        }

        .profile-match-stats {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            justify-content: flex-end;
        }

        .profile-match-stats span {
            background: var(--soft-indigo);
            border: 1px solid #c7d2fe;
            border-radius: 999px;
            color: #4338ca;
            font-size: 0.82rem;
            font-weight: 800;
            padding: 7px 10px;
        }

        .edit {
            background: var(--soft-indigo);
            border: 1px solid #c7d2fe;
            color: #4338ca;
        }

        .delete {
            background: #fef2f2;
            border: 1px solid #fecaca;
            color: var(--danger);
        }

        .map-picker {
            background: #ffffff;
            border: 1px solid var(--border);
            border-radius: var(--radius-md);
            box-shadow: var(--shadow-sm);
            margin-bottom: 20px;
            overflow: hidden;
        }

        .map-picker-header {
            padding: 18px 20px 14px;
        }

        .map-picker-header h3 {
            color: var(--text);
            font-family: 'Open Sans', sans-serif;
            font-size: 1.05rem;
            font-weight: 800;
            margin: 0 0 6px;
            text-transform: none;
        }

        .map-picker-header p,
        .location-status {
            color: var(--muted);
            margin: 0;
        }

        .location-map {
            height: 320px;
            width: 100%;
        }

        .location-status {
            margin: 12px 20px 18px;
            min-height: 20px;
        }

        .location-status-error {
            color: var(--danger);
            font-weight: 700;
        }

        .location-grid {
            display: grid;
            gap: 18px;
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .footer {
            background: #ffffff;
            border-top: 1px solid var(--border);
            color: var(--text);
            flex-shrink: 0;
            margin-top: auto;
            padding: 26px 20px 14px;
        }

        .footer-content {
            align-items: center;
            display: flex;
            flex-wrap: wrap;
            gap: 24px;
            justify-content: space-between;
            margin: auto;
            max-width: 1100px;
            width: 90%;
        }

        .footer-brand h3 {
            color: var(--text);
            font-family: 'Open Sans', sans-serif;
            font-size: 1.15rem;
            font-weight: 800;
            margin: 0 0 8px;
            text-transform: none;
        }

        .footer-brand p {
            color: var(--muted);
            margin: 0;
        }

        .footer-links {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
        }

        .footer-links a {
            border-radius: 999px;
            color: var(--muted);
            font-weight: 800;
            padding: 8px 12px;
            text-decoration: none;
            transition: 0.2s;
        }

        .footer-links a:hover {
            background: var(--soft-purple);
            color: var(--primary);
        }

        .footer-bottom {
            border-top: 1px solid var(--border);
            margin: 24px auto 0;
            max-width: 1100px;
            padding-top: 15px;
            text-align: center;
            width: 90%;
        }

        .footer-bottom p {
            color: var(--muted);
            font-size: 0.9rem;
            margin: 0;
        }

        @media (max-width: 768px) {
            header {
                height: 205px;
            }

            .container {
                border-radius: 24px;
                margin-top: -32px;
                padding: 20px;
                width: 94%;
            }

            .home-actions a,
            .home-actions .btn-add,
            .home-actions .btn-secondary {
                width: 100%;
            }

            .location-grid {
                gap: 0;
                grid-template-columns: 1fr;
            }

            .location-map {
                height: 280px;
            }

            .profile-map {
                height: 260px;
            }

            .profile-public-grid {
                grid-template-columns: 1fr;
            }

            .profile-summary-card,
            .profile-qr-card,
            .profile-match-item {
                align-items: flex-start;
                flex-direction: column;
            }

            .profile-match-stats {
                justify-content: flex-start;
            }

            table {
                display: block;
                overflow-x: auto;
                white-space: nowrap;
            }

            .footer-content {
                justify-content: center;
                text-align: center;
            }

            .footer-links {
                justify-content: center;
            }
        }
    </style>
</head>
<body>

<header>
    <h1>Preguntados</h1>
    <p>Demostrá cuánto sabés y competí con otros jugadores</p>
</header>
