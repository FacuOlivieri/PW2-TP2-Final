{{>header}}
<main class="container">
    {{#propuesta}}
        <section class="proposal-detail-card">
            <div class="proposal-detail-header">
                <div>
                    <p class="lobby-kicker">Pregunta propuesta</p>
                    <h2 class="form-title">{{texto}}</h2>
                </div>
                <span class="estado-badge estado-{{estado}}">{{estado}}</span>
            </div>

            <div class="proposal-detail-meta">
                <article>
                    <strong>Categoría</strong>
                    <span>{{categoria}}</span>
                </article>
                <article>
                    <strong>Usuario</strong>
                    <span>{{usuario}}</span>
                </article>
                <article>
                    <strong>Fecha</strong>
                    <span>{{fecha_creacion}}</span>
                </article>
            </div>

            <h3 class="proposal-detail-subtitle">Respuestas</h3>

            <div class="proposal-detail-answers">
                {{#respuestas}}
                    <article class="proposal-answer-card {{#es_correcta_bool}}correct-answer{{/es_correcta_bool}}">
                        <span>{{texto}}</span>
                        {{#es_correcta_bool}}<strong>Respuesta correcta</strong>{{/es_correcta_bool}}
                    </article>
                {{/respuestas}}
            </div>

            <div class="proposal-detail-actions">
                {{#esPendiente}}
                    <form action="/preguntaCreada/aprobar" method="POST">
                        <input type="hidden" name="pregunta_creada_id" value="{{id}}">
                        <button type="submit" class="btn-secondary btn-aprobar">Aprobar pregunta</button>
                    </form>
                    <form action="/preguntaCreada/rechazar" method="POST">
                        <input type="hidden" name="pregunta_creada_id" value="{{id}}">
                        <button type="submit" class="btn-secondary btn-rechazar">Rechazar pregunta</button>
                    </form>
                {{/esPendiente}}

                <a href="/preguntaCreada/propuestas?estado={{estado}}" class="back-link">Volver al listado</a>
            </div>
        </section>
    {{/propuesta}}
</main>

<style>
    .proposal-detail-card {
        background: #ffffff;
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-soft);
        margin: 0 auto;
        max-width: 920px;
        padding: 30px;
    }

    .proposal-detail-header {
        align-items: flex-start;
        display: flex;
        gap: 16px;
        justify-content: space-between;
        margin-bottom: 22px;
    }

    .proposal-detail-header .form-title {
        font-size: clamp(1.7rem, 3vw, 2.5rem);
        margin: 0;
        text-align: left;
    }

    .proposal-detail-meta {
        display: grid;
        gap: 14px;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        margin-bottom: 24px;
    }

    .proposal-detail-meta article {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius-sm);
        padding: 14px;
    }

    .proposal-detail-meta strong,
    .proposal-detail-meta span {
        display: block;
    }

    .proposal-detail-meta strong {
        color: var(--primary);
        font-size: 0.78rem;
        letter-spacing: 0.08em;
        margin-bottom: 5px;
        text-transform: uppercase;
    }

    .proposal-detail-subtitle {
        color: var(--text);
        font-size: 1.25rem;
        margin: 0 0 14px;
    }

    .proposal-detail-answers {
        display: grid;
        gap: 12px;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        margin-bottom: 26px;
    }

    .proposal-answer-card {
        background: #ffffff;
        border: 1px solid var(--border);
        border-radius: var(--radius-sm);
        color: var(--muted);
        padding: 16px;
    }

    .proposal-answer-card.correct-answer {
        background: #ecfdf5;
        border-color: #a7f3d0;
        color: var(--success);
        font-weight: 800;
    }

    .proposal-answer-card span,
    .proposal-answer-card strong {
        display: block;
    }

    .proposal-answer-card strong {
        font-size: 0.75rem;
        letter-spacing: 0.06em;
        margin-top: 6px;
        text-transform: uppercase;
    }

    .proposal-detail-actions {
        align-items: center;
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
    }

    .proposal-detail-actions form {
        margin: 0;
    }

    .proposal-detail-actions button {
        cursor: pointer;
    }

    .proposal-detail-actions .back-link {
        align-items: center;
        display: inline-flex;
        margin-top: 0;
        min-height: 42px;
        text-align: left;
    }

    .btn-aprobar {
        background: #ecfdf5;
        border: 1px solid #a7f3d0;
        color: var(--success);
    }

    .btn-rechazar {
        background: #fef2f2;
        border: 1px solid #fecaca;
        color: var(--danger);
    }

    .estado-badge {
        border-radius: 999px;
        display: inline-block;
        font-size: 0.78rem;
        font-weight: 800;
        padding: 5px 12px;
        text-transform: capitalize;
        white-space: nowrap;
    }

    .estado-pendiente {
        background: var(--soft-amber);
        border: 1px solid #fde68a;
        color: #92400e;
    }

    .estado-aceptada {
        background: #ecfdf5;
        border: 1px solid #a7f3d0;
        color: var(--success);
    }

    .estado-rechazada {
        background: #fef2f2;
        border: 1px solid #fecaca;
        color: var(--danger);
    }

    @media (max-width: 760px) {
        .proposal-detail-card {
            padding: 22px;
        }

        .proposal-detail-header,
        .proposal-detail-actions {
            align-items: stretch;
            flex-direction: column;
        }

        .proposal-detail-meta,
        .proposal-detail-answers {
            grid-template-columns: 1fr;
        }
    }
</style>
{{>footer}}
