<style>
    .dashboard-shell {
        background: #fbfbff;
        color: #1e1b4b;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        min-height: 100vh;
    }

    .dashboard-hero {
        background: radial-gradient(circle at 12% 18%, rgba(124, 58, 237, 0.08), transparent 24%),
        linear-gradient(135deg, #ffffff 0%, #f5f3ff 58%, #eef2ff 100%);
        border-bottom: 1px solid #e2e8f0;
        padding: 32px 40px;
        position: relative;
    }

    .dashboard-hero::after {
        background: linear-gradient(90deg, #6366f1, #a855f7, #38bdf8);
        bottom: 0;
        content: "";
        height: 5px;
        left: 0;
        opacity: 0.72;
        position: absolute;
        right: 0;
    }

    .dashboard-hero-top {
        align-items: flex-start;
        display: flex;
        gap: 24px;
        justify-content: space-between;
    }

    .dashboard-kicker {
        color: #6366f1;
        font-size: 0.82rem;
        font-weight: 800;
        letter-spacing: 0.08em;
        margin: 0 0 12px;
        text-transform: uppercase;
    }

    .dashboard-title {
        color: #0f172a;
        font-size: clamp(2rem, 4vw, 2.6rem);
        font-weight: 800;
        line-height: 1.1;
        margin: 0;
    }

    .dashboard-title span {
        color: #64748b;
        display: block;
        font-size: 1rem;
        font-weight: 500;
        margin-top: 8px;
    }

    .btn-print,
    .btn-back,
    .btn-filter {
        border-radius: 14px;
        font-weight: 800;
        text-decoration: none;
        transition: all 0.2s ease;
    }

    .btn-print {
        background: #6366f1;
        border: 0;
        color: #ffffff;
        cursor: pointer;
        font-size: 1rem;
        padding: 16px 28px;
        white-space: nowrap;
    }

    .btn-print:hover {
        background: #4f46e5;
        transform: translateY(-1px);
    }

    .dashboard-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 26px;
    }

    .btn-filter {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        color: #64748b;
        display: inline-block;
        font-size: 0.9rem;
        padding: 10px 22px;
    }

    .btn-filter:hover {
        background: #f8fafc;
        color: #4f46e5;
    }

    .btn-filter.active {
        background: #6366f1;
        border-color: #4f46e5;
        color: #ffffff;
    }

    .dashboard-content {
        padding: 32px 40px;
    }

    .dashboard-section {
        margin-bottom: 38px;
    }

    .section-title {
        color: #0f172a;
        font-size: 1.2rem;
        font-weight: 800;
        letter-spacing: 0.05em;
        margin: 0 0 18px;
        text-transform: uppercase;
    }

    .metrics-summary {
        display: grid;
        gap: 18px;
        margin-bottom: 24px;
    }

    .metrics-summary-wide {
        grid-template-columns: repeat(5, minmax(0, 1fr));
    }

    .metric-stat,
    .data-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 18px;
        box-shadow: 0 16px 35px rgba(79, 70, 229, 0.07);
    }

    .metric-stat {
        padding: 22px;
    }

    .metric-stat strong {
        color: #0f172a;
        display: block;
        font-size: 2.15rem;
        font-weight: 900;
        line-height: 1;
        margin-bottom: 8px;
    }

    .metric-stat span {
        color: #64748b;
        font-size: 0.78rem;
        font-weight: 800;
        letter-spacing: 0.05em;
        text-transform: uppercase;
    }

    .reports-grid {
        display: grid;
        gap: 22px;
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .report-card-wide {
        grid-column: 1 / -1;
    }

    .data-card {
        overflow: hidden;
    }

    .data-card-header {
        align-items: flex-start;
        display: flex;
        gap: 18px;
        justify-content: space-between;
        padding: 24px 24px 14px;
    }

    .data-card-header h3 {
        color: #0f172a;
        font-size: 1.08rem;
        font-weight: 900;
        margin: 0;
    }

    .data-card-header p {
        color: #64748b;
        font-size: 0.86rem;
        line-height: 1.45;
        margin: 5px 0 0;
    }

    .data-badge {
        background: #f5f3ff;
        border: 1px solid #ddd6fe;
        border-radius: 999px;
        color: #6d28d9;
        font-size: 0.72rem;
        font-weight: 800;
        padding: 6px 12px;
        text-transform: uppercase;
        white-space: nowrap;
    }

    .chart-box {
        height: 290px;
        padding: 8px 22px 18px;
        position: relative;
    }

    .chart-box canvas {
        display: block;
        height: 100% !important;
        width: 100% !important;
    }

    .data-table {
        border-collapse: collapse;
        width: 100%;
    }

    .data-table th {
        background: #f8fafc;
        border-bottom: 1px solid #e2e8f0;
        color: #64748b;
        font-size: 0.74rem;
        font-weight: 900;
        letter-spacing: 0.05em;
        padding: 12px 24px;
        text-align: left;
        text-transform: uppercase;
    }

    .data-table td {
        border-bottom: 1px solid #f1f5f9;
        color: #334155;
        font-size: 0.94rem;
        padding: 13px 24px;
    }

    .data-table th:last-child,
    .data-table td:last-child {
        text-align: right;
    }

    .data-table tbody tr:last-child td {
        border-bottom: 0;
    }

    .row-highlight {
        color: #4f46e5;
        font-weight: 800;
    }

    .dashboard-footer {
        align-items: center;
        display: flex;
        justify-content: center;
        padding: 4px 40px 48px;
    }

    .btn-back {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        box-shadow: 0 8px 20px rgba(79, 70, 229, 0.06);
        color: #0f172a;
        padding: 14px 32px;
    }

    .btn-back:hover {
        background: #f8fafc;
        transform: translateY(-1px);
    }

    @media (max-width: 1100px) {
        .metrics-summary-wide {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }

    @media (max-width: 860px) {
        .dashboard-hero,
        .dashboard-content,
        .dashboard-footer {
            padding-left: 20px;
            padding-right: 20px;
        }

        .dashboard-hero-top {
            flex-direction: column;
        }

        .btn-print {
            width: 100%;
        }

        .metrics-summary-wide,
        .reports-grid {
            grid-template-columns: 1fr;
        }

        .report-card-wide {
            grid-column: auto;
        }

        .chart-box {
            height: 250px;
        }
    }

    .print-chart-image {
        display: none;
    }

    @media print {
        @page {
            margin: 14mm;
        }

        .dashboard-shell,
        .dashboard-hero,
        .dashboard-footer {
            background: #ffffff !important;
        }

        .dashboard-actions,
        .btn-print,
        .btn-back,
        .dashboard-footer,
        .data-badge {
            display: none !important;
        }

        .chart-box {
            display: block !important;
            height: auto !important;
            min-height: 180px !important;
            padding: 8px 14px 12px !important;
        }

        .chart-box canvas {
            display: none !important;
        }

        .print-chart-image {
            display: block !important;
            height: auto;
            max-height: 230px;
            max-width: 100%;
            object-fit: contain;
            width: 100%;
        }

        .dashboard-hero {
            border-bottom: 1px solid #111827;
            padding: 0 0 16px;
        }

        .dashboard-hero::after {
            display: none;
        }

        .dashboard-title {
            font-size: 1.5rem;
        }

        .dashboard-title span,
        .dashboard-kicker,
        .data-card-header p {
            color: #111827;
        }

        .dashboard-content {
            padding: 18px 0 0;
        }

        .metrics-summary-wide,
        .reports-grid {
            display: block;
        }

        .metric-stat,
        .data-card {
            border: 1px solid #111827;
            box-shadow: none;
            margin-bottom: 14px;
            page-break-inside: avoid;
        }

        .metric-stat {
            display: inline-block;
            margin-right: 8px;
            padding: 10px 14px;
            width: 17%;
        }

        .metric-stat strong {
            font-size: 1.25rem;
        }

        .data-card-header {
            padding: 12px 14px 8px;
        }

        .data-table th,
        .data-table td {
            border: 1px solid #cbd5e1;
            color: #111827;
            font-size: 0.8rem;
            padding: 7px 9px;
        }
    }
</style>
